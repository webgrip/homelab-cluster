{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "forgejo",
    "github",
    "repos"
  ],
  "properties": {
    "apiVersion": {
      "const": "repo-config.webgrip.io/v1alpha1"
    },
    "kind": {
      "const": "RepoSet"
    },
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner"
      ],
      "properties": {
        "owner": {
          "const": "webgrip"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners"
      ],
      "properties": {
        "owners": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "app_secret_path"
            ],
            "properties": {
              "app_secret_path": {
                "type": "string",
                "pattern": "^github/[a-z0-9-]+-app$"
              }
            }
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "homelab-cluster",
        "unfold",
        "ploeg-hq/ploeg"
      ],
      "patternProperties": {
        "^[A-Za-z0-9._-]+$": {
          "$ref": "#/$defs/forgejoRepo"
        },
        "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$": {
          "$ref": "#/$defs/githubRepo"
        }
      },
      "additionalProperties": false,
      "properties": {
        "homelab-cluster": {
          "properties": {
            "core": {
              "const": true
            },
            "branches": {
              "properties": {
                "main": {
                  "propertyNames": {
                    "const": "status_checks"
                  }
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "settings"
                ]
              },
              {
                "required": [
                  "tags"
                ]
              }
            ]
          },
          "required": [
            "core"
          ]
        }
      }
    }
  },
  "$defs": {
    "profileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "repoKind": {
      "enum": [
        "service",
        "image-set",
        "package",
        "site",
        "config",
        "none"
      ]
    },
    "forgejoRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge"
      ],
      "properties": {
        "forge": {
          "const": "forgejo"
        },
        "kind": {
          "$ref": "#/$defs/repoKind"
        },
        "core": {
          "const": true
        },
        "staged": {
          "const": true
        },
        "writer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "settings": {
          "$ref": "settings.schema.json"
        },
        "branches": {
          "$ref": "branch-protection.schema.json"
        },
        "renovate": {
          "$ref": "renovate.schema.json"
        },
        "tags": {
          "$ref": "tag-protection.schema.json"
        }
      }
    },
    "githubRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge",
        "profile"
      ],
      "properties": {
        "forge": {
          "const": "github"
        },
        "profile": {
          "$ref": "#/$defs/profileName"
        },
        "kind": {
          "$ref": "#/$defs/repoKind"
        },
        "mirror_of": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "managed": {
          "const": false
        },
        "settings": {
          "$ref": "github-settings.schema.json"
        },
        "rulesets": {
          "$ref": "github-rulesets.schema.json"
        },
        "release_consumers": {
          "type": "string",
          "minLength": 2
        },
        "renovate": {
          "$ref": "renovate.schema.json"
        }
      }
    }
  }
}

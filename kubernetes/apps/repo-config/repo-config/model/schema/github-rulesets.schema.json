{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHubRulesets",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9-]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "target",
      "include",
      "deletion",
      "non_fast_forward",
      "update",
      "required_status_checks",
      "bypass_repository_role_ids"
    ],
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "name": { "type": "string", "minLength": 1 },
      "target": { "enum": ["branch", "tag"] },
      "include": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^(refs/(heads|tags)/.+|~DEFAULT_BRANCH|~ALL)$" }
      },
      "deletion": { "type": "boolean" },
      "non_fast_forward": { "type": "boolean" },
      "update": { "type": "boolean" },
      "required_status_checks": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "integration_id"],
          "properties": {
            "context": { "type": "string", "minLength": 1 },
            "integration_id": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "bypass_repository_role_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "integer", "minimum": 1 }
      },
      "pull_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required_approving_review_count", "allowed_merge_methods"],
        "properties": {
          "required_approving_review_count": { "type": "integer", "minimum": 0, "maximum": 10 },
          "allowed_merge_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["merge", "squash", "rebase"] }
          },
          "dismiss_stale_reviews_on_push": { "type": "boolean" },
          "require_code_owner_review": { "type": "boolean" },
          "require_last_push_approval": { "type": "boolean" },
          "required_review_thread_resolution": { "type": "boolean" }
        }
      },
      "merge_queue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["merge_method", "grouping_strategy"],
        "properties": {
          "merge_method": { "enum": ["MERGE", "SQUASH", "REBASE"] },
          "grouping_strategy": { "enum": ["ALLGREEN", "HEADGREEN"] },
          "check_response_timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 360 },
          "max_entries_to_build": { "type": "integer", "minimum": 0, "maximum": 100 },
          "max_entries_to_merge": { "type": "integer", "minimum": 0, "maximum": 100 },
          "min_entries_to_merge": { "type": "integer", "minimum": 0, "maximum": 100 },
          "min_entries_to_merge_wait_minutes": { "type": "integer", "minimum": 0, "maximum": 360 }
        }
      }
    }
  }
}

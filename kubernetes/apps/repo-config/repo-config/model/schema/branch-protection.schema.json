{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchProtections",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[A-Za-z0-9._/-]+$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status_checks"
    ],
    "properties": {
      "push": {
        "$ref": "#/$defs/usernames"
      },
      "merge": {
        "$ref": "#/$defs/usernames"
      },
      "status_checks": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[^\\[\\]\\\\]|\\\\.)*$"
        }
      },
      "required_approvals": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "dismiss_stale_approvals": {
        "type": "boolean"
      },
      "block_on_rejected_reviews": {
        "type": "boolean"
      },
      "block_on_outdated_branch": {
        "type": "boolean"
      }
    }
  },
  "$defs": {
    "usernames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TagProtections",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "minLength": 1,
    "pattern": "^[^\\s]+$"
  },
  "additionalProperties": {
    "type": "array",
    "uniqueItems": true,
    "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}

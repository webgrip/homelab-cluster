{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "profiles"
  ],
  "properties": {
    "apiVersion": {
      "const": "repo-config.webgrip.io/v1alpha1"
    },
    "kind": {
      "const": "ProfileSet"
    },
    "profiles": {
      "type": "object",
      "required": [
        "baseline",
        "homelab"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "properties": {
        "baseline": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo",
            "github"
          ]
        },
        "homelab": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo"
          ],
          "properties": {
            "forgejo": {
              "required": [
                "branches"
              ],
              "properties": {
                "branches": {
                  "required": [
                    "main"
                  ],
                  "properties": {
                    "main": {
                      "properties": {
                        "push": {
                          "contains": {
                            "const": "ryangr0"
                          }
                        }
                      },
                      "required": [
                        "push",
                        "merge"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "forgejo": {
          "$ref": "#/$defs/forgejo"
        },
        "github": {
          "$ref": "#/$defs/github"
        }
      }
    },
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "allOf": [
            {
              "$ref": "settings.schema.json"
            },
            {
              "required": [
                "has_actions",
                "has_pull_requests",
                "has_releases",
                "default_merge_style",
                "default_delete_branch_after_merge",
                "allow_fast_forward_only_merge",
                "allow_squash_merge"
              ]
            }
          ]
        },
        "branches": {
          "$ref": "branch-protection.schema.json"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "github-settings.schema.json",
          "not": {
            "required": [
              "default_branch"
            ]
          }
        }
      }
    }
  }
}

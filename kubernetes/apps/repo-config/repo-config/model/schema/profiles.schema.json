{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "profiles",
    "staged",
    "kinds"
  ],
  "properties": {
    "apiVersion": {
      "const": "repo-config.webgrip.io/v1alpha1"
    },
    "kind": {
      "const": "ProfileSet"
    },
    "profiles": {
      "type": "object",
      "required": [
        "baseline",
        "protected",
        "protected-core",
        "workspace"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "properties": {
        "baseline": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo",
            "github"
          ]
        },
        "protected": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo"
          ],
          "properties": {
            "forgejo": {
              "required": [
                "branches",
                "tags"
              ],
              "properties": {
                "branches": {
                  "required": [
                    "main"
                  ],
                  "properties": {
                    "main": {
                      "required": [
                        "push",
                        "merge",
                        "required_approvals"
                      ],
                      "properties": {
                        "push": {
                          "maxItems": 0
                        },
                        "merge": {
                          "contains": {
                            "const": "ryangr0"
                          }
                        },
                        "required_approvals": {
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "protected-core": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo"
          ],
          "properties": {
            "forgejo": {
              "required": [
                "branches",
                "tags"
              ],
              "properties": {
                "branches": {
                  "required": [
                    "main"
                  ],
                  "properties": {
                    "main": {
                      "required": [
                        "push",
                        "merge",
                        "required_approvals"
                      ],
                      "properties": {
                        "push": {
                          "maxItems": 0
                        },
                        "merge": {
                          "contains": {
                            "const": "ryangr0"
                          }
                        },
                        "required_approvals": {
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "workspace": {
          "$ref": "#/$defs/profile",
          "required": [
            "forgejo"
          ],
          "properties": {
            "forgejo": {
              "required": [
                "branches"
              ],
              "properties": {
                "branches": {
                  "required": [
                    "main"
                  ],
                  "properties": {
                    "main": {
                      "required": [
                        "push",
                        "merge"
                      ],
                      "properties": {
                        "push": {
                          "maxItems": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "staged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "branches"
      ],
      "properties": {
        "settings": {
          "$ref": "settings.schema.json"
        },
        "branches": {
          "allOf": [
            {
              "$ref": "branch-protection.schema.json"
            },
            {
              "required": [
                "development"
              ],
              "properties": {
                "development": {
                  "required": [
                    "push",
                    "merge"
                  ],
                  "properties": {
                    "push": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "image-set",
        "package",
        "site",
        "config",
        "none"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/kindDefaults"
        },
        "image-set": {
          "$ref": "#/$defs/kindDefaults"
        },
        "package": {
          "$ref": "#/$defs/kindDefaults"
        },
        "site": {
          "$ref": "#/$defs/kindDefaults"
        },
        "config": {
          "$ref": "#/$defs/kindDefaults"
        },
        "none": {
          "$ref": "#/$defs/kindDefaults"
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "forgejo": {
          "$ref": "#/$defs/forgejo"
        },
        "github": {
          "$ref": "#/$defs/github"
        }
      }
    },
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "allOf": [
            {
              "$ref": "settings.schema.json"
            },
            {
              "required": [
                "has_actions",
                "has_pull_requests",
                "has_releases",
                "default_merge_style",
                "default_delete_branch_after_merge",
                "allow_fast_forward_only_merge",
                "allow_squash_merge"
              ]
            }
          ]
        },
        "branches": {
          "$ref": "branch-protection.schema.json"
        },
        "tags": {
          "$ref": "tag-protection.schema.json"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "github-settings.schema.json",
          "not": {
            "required": [
              "default_branch"
            ]
          }
        }
      }
    },
    "kindDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renovate": {
          "$ref": "renovate.schema.json"
        }
      }
    }
  }
}

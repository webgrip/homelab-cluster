query distill_notes() {
    match {
        $n: Note
    }
    return { $n.slug, $n.name, $n.kind, $n.content, $n.tags }
}

query distill_artifacts() {
    match {
        $n: Artifact
    }
    return { $n.slug, $n.name, $n.kind, $n.content }
}

query distill_projects() {
    match {
        $n: Project
    }
    return { $n.slug, $n.name, $n.brief, $n.description, $n.tags }
}

query distill_people() {
    match {
        $n: Person
    }
    return { $n.slug, $n.name, $n.first_name, $n.last_name, $n.relation }
}

query distill_orgs() {
    match {
        $n: Organization
    }
    return { $n.slug, $n.name, $n.kind }
}

query distill_places() {
    match {
        $n: Place
    }
    return { $n.slug, $n.name, $n.kind }
}

query distill_areas() {
    match {
        $n: Area
    }
    return { $n.slug, $n.name, $n.kind, $n.status }
}

query distill_topics() {
    match {
        $n: Topic
    }
    return { $n.slug, $n.name, $n.description, $n.aliases, $n.embedding, $n.createdAt }
}

query distill_state() {
    match {
        $n: Distillation
    }
    return { $n.slug, $n.source, $n.content_sha256, $n.extractor, $n.createdAt }
}

query edge_Knows_to() {
    match {
        $s: Person
        $s $e:knows $t
        $t.slug starts_with "derived/"
    }
    return { $e.@id, $s.@id, $t.@id }
}

query edge_Knows_from() {
    match {
        $s: Person
        $s $e:knows $t
        $s.slug starts_with "derived/"
    }
    return { $e.@id, $s.@id, $t.@id }
}


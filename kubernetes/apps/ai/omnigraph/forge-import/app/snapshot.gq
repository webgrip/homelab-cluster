query forge_projects() {
    match {
        $n: Project
        $n.slug starts_with "forge/"
    }
    return { $n.slug, $n.name, $n.kind, $n.status, $n.brief, $n.description, $n.tags, $n.createdAt }
}

query forge_orgs() {
    match {
        $n: Organization
        $n.slug starts_with "forge/"
    }
    return { $n.slug, $n.name, $n.kind, $n.brief, $n.website, $n.createdAt }
}

query forge_people() {
    match {
        $n: Person
        $n.slug starts_with "forge/"
    }
    return { $n.slug, $n.name, $n.relation, $n.brief, $n.tags, $n.createdAt }
}

query forge_artifacts() {
    match {
        $n: Artifact
        $n.slug starts_with "forge/"
    }
    return { $n.slug, $n.name, $n.kind, $n.source, $n.source_ref, $n.thread_id, $n.url, $n.content_sha256, $n.timestamp, $n.createdAt }
}

query forge_notes() {
    match {
        $n: Note
        $n.slug starts_with "forge/"
    }
    return { $n.slug, $n.name, $n.kind, $n.content, $n.when, $n.tags, $n.createdAt, $n.updatedAt }
}

query forge_passages() {
    match {
        $p: Passage
        $p passageOf $a
        $a.slug starts_with "forge/"
    }
    return { $p.@id, $a.slug, $p.createdAt }
}

query forge_passages_with_vectors($v: Vector(384)) {
    match {
        $p: Passage
        $p passageOf $a
        $a.slug starts_with "forge/"
    }
    return { $p.@id }
    order { nearest($p.embedding, $v) }
    limit 1000000
}

query forge_notes_with_vectors($v: Vector(384)) {
    match {
        $n: Note
        $n.slug starts_with "forge/"
    }
    return { $n.slug }
    order { nearest($n.embedding, $v) }
    limit 1000000
}

query forge_project_orgs() {
    match {
        $n: Project
        $n.slug starts_with "forge/"
        $n projectForOrganization $t
    }
    return { $n.slug, $t.slug }
}

query forge_artifact_projects() {
    match {
        $n: Artifact
        $n.slug starts_with "forge/"
        $n artifactForProject $t
    }
    return { $n.slug, $t.slug }
}

query forge_artifact_people() {
    match {
        $n: Artifact
        $n.slug starts_with "forge/"
        $n artifactFromPerson $t
    }
    return { $n.slug, $t.slug }
}

query forge_note_projects() {
    match {
        $n: Note
        $n.slug starts_with "forge/"
        $n noteAboutProject $t
    }
    return { $n.slug, $t.slug }
}

query forge_note_artifacts() {
    match {
        $n: Note
        $n.slug starts_with "forge/"
        $n noteFromArtifact $t
    }
    return { $n.slug, $t.slug }
}

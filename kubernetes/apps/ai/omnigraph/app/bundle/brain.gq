query get_note($slug: String) {
    match {
        $n: Note { slug: $slug }
    }
    return { $n.slug, $n.name, $n.kind, $n.content, $n.when, $n.tags }
}

query notes_recent() {
    match {
        $n: Note
    }
    return { $n.slug, $n.name, $n.kind, $n.when }
    order { $n.when desc }
    limit 30
}

query notes_by_kind($kind: String) {
    match {
        $n: Note { kind: $kind }
    }
    return { $n.slug, $n.name, $n.content, $n.when, $n.tags }
    order { $n.when desc }
}

query note_related($slug: String) {
    match {
        $n: Note { slug: $slug }
        $n relatedNote $other
    }
    return { $other.slug, $other.name, $other.kind }
}

query preferences_for_person($slug: String) {
    match {
        $p: Person { slug: $slug }
        $n: Note { kind: "preference" }
        $n noteAboutPerson $p
    }
    return { $n.slug, $n.name, $n.content, $n.tags }
}

query principles_all() {
    match {
        $n: Note { kind: "principle" }
    }
    return { $n.slug, $n.name, $n.content }
    order { $n.name }
}

query open_questions() {
    match {
        $n: Note { kind: "question" }
    }
    return { $n.slug, $n.name, $n.content, $n.when }
    order { $n.when desc }
}

query note_from_artifact($slug: String) {
    match {
        $a: Artifact { slug: $slug }
        $n noteFromArtifact $a
    }
    return { $n.slug, $n.name, $n.kind, $n.content }
}

query get_person($slug: String) {
    match {
        $p: Person { slug: $slug }
    }
    return { $p.slug, $p.name, $p.relation, $p.location, $p.current_role, $p.birthday, $p.cadence_days, $p.brief }
}

query people_all() {
    match {
        $p: Person
    }
    return { $p.slug, $p.name, $p.relation, $p.location, $p.cadence_days }
    order { $p.name }
}

query people_by_relation($relation: String) {
    match {
        $p: Person { relation: $relation }
    }
    return { $p.slug, $p.name, $p.location, $p.cadence_days, $p.birthday, $p.brief }
    order { $p.name }
}

query close_friends() {
    match {
        $p: Person { relation: "close-friend" }
    }
    return { $p.slug, $p.name, $p.location, $p.cadence_days, $p.brief }
    order { $p.cadence_days }
}

query family_members() {
    match {
        $p: Person { relation: "family" }
    }
    return { $p.slug, $p.name, $p.location, $p.cadence_days, $p.birthday }
    order { $p.name }
}

query person_knows($slug: String) {
    match {
        $p: Person { slug: $slug }
        $p knows $other
    }
    return { $other.slug, $other.name, $other.relation, $other.location }
}

query person_family($slug: String) {
    match {
        $p: Person { slug: $slug }
        $p relatedToPerson $r
    }
    return { $r.slug, $r.name, $r.relation, $r.location }
}

query person_lives_in($slug: String) {
    match {
        $p: Person { slug: $slug }
        $p livesIn $pl
    }
    return { $pl.slug, $pl.name, $pl.kind, $pl.address }
}

query person_works_at($slug: String) {
    match {
        $p: Person { slug: $slug }
        $p worksAt $o
    }
    return { $o.slug, $o.name, $o.kind, $o.website }
}

query person_recent_events($slug: String) {
    match {
        $p: Person { slug: $slug }
        $e attendedBy $p
    }
    return { $e.slug, $e.name, $e.kind, $e.when, $e.mood, $e.brief }
    order { $e.when desc }
    limit 20
}

query person_artifacts_mentioning($slug: String) {
    match {
        $p: Person { slug: $slug }
        $a mentionsPerson $p
    }
    return { $a.slug, $a.name, $a.kind, $a.source, $a.timestamp }
    order { $a.timestamp desc }
    limit 20
}

query person_artifacts_from($slug: String) {
    match {
        $p: Person { slug: $slug }
        $a artifactFromPerson $p
    }
    return { $a.slug, $a.name, $a.kind, $a.source, $a.timestamp }
    order { $a.timestamp desc }
    limit 20
}

query person_tasks_i_owe($slug: String) {
    match {
        $p: Person { slug: $slug }
        $t: Task { direction: "i-owe" }
        $t taskForPerson $p
        $t.status != "done"
        $t.status != "cancelled"
    }
    return { $t.slug, $t.name, $t.status, $t.priority, $t.due, $t.brief }
    order { $t.due }
}

query person_tasks_they_owe($slug: String) {
    match {
        $p: Person { slug: $slug }
        $t: Task { direction: "they-owe" }
        $t taskForPerson $p
        $t.status != "done"
        $t.status != "cancelled"
    }
    return { $t.slug, $t.name, $t.status, $t.due, $t.brief }
    order { $t.due }
}

query person_notes($slug: String) {
    match {
        $p: Person { slug: $slug }
        $n noteAboutPerson $p
    }
    return { $n.slug, $n.name, $n.kind, $n.content, $n.when }

query get_artifact($slug: String) {
    match {
        $a: Artifact { slug: $slug }
    }
    return { $a.slug, $a.name, $a.kind, $a.source, $a.url, $a.thread_id, $a.timestamp }
}

query artifacts_recent() {
    match {
        $a: Artifact
    }
    return { $a.slug, $a.name, $a.kind, $a.source, $a.timestamp }
    order { $a.timestamp desc }
    limit 30
}

query artifacts_by_source($source: String) {
    match {
        $a: Artifact { source: $source }
    }
    return { $a.slug, $a.name, $a.kind, $a.timestamp }
    order { $a.timestamp desc }
}

query artifacts_by_thread($thread_id: String) {
    match {
        $a: Artifact { thread_id: $thread_id }
    }
    return { $a.slug, $a.name, $a.kind, $a.source, $a.timestamp }
    order { $a.timestamp }
}

query artifact_mentions($slug: String) {
    match {
        $a: Artifact { slug: $slug }
        $a mentionsPerson $p
    }
    return { $p.slug, $p.name, $p.relation }
}

query artifact_derived_from($slug: String) {
    match {
        $a: Artifact { slug: $slug }
        $a derivedFromArtifact $src
    }
    return { $src.slug, $src.name, $src.kind, $src.source }
}

query get_event($slug: String) {
    match {
        $e: Event { slug: $slug }
    }
    return { $e.slug, $e.name, $e.kind, $e.when, $e.end_at, $e.mood, $e.brief, $e.description }
}

query events_recent() {
    match {
        $e: Event
    }
    return { $e.slug, $e.name, $e.kind, $e.when, $e.mood, $e.brief }
    order { $e.when desc }
    limit 30
}

query events_chronological() {
    match {
        $e: Event
    }
    return { $e.slug, $e.name, $e.kind, $e.when, $e.brief }
    order { $e.when }
}

query events_by_kind($kind: String) {
    match {
        $e: Event { kind: $kind }
    }
    return { $e.slug, $e.name, $e.when, $e.mood, $e.brief }
    order { $e.when desc }
}

query event_attendees($slug: String) {
    match {
        $e: Event { slug: $slug }
        $e attendedBy $p
    }
    return { $p.slug, $p.name, $p.relation }
}

query event_place($slug: String) {
    match {
        $e: Event { slug: $slug }
        $e happenedAt $pl
    }
    return { $pl.slug, $pl.name, $pl.kind, $pl.address }
}

query event_project($slug: String) {
    match {
        $e: Event { slug: $slug }
        $e eventForProject $proj
    }
    return { $proj.slug, $proj.name, $proj.kind, $proj.status }
}

query person_life_events($slug: String) {
    match {
        $p: Person { slug: $slug }
        $e eventForPerson $p
    }
    return { $e.slug, $e.name, $e.kind, $e.when, $e.brief }
    order { $e.when desc }
}

query get_media($slug: String) {
    match {
        $m: Media { slug: $slug }
    }
    return { $m.slug, $m.name, $m.kind, $m.status, $m.rating, $m.url, $m.published_date, $m.brief, $m.tags }
}

query reading_queue() {
    match {
        $m: Media { kind: "book", status: "want" }
    }
    return { $m.slug, $m.name, $m.brief, $m.tags }
    order { $m.name }
}

query finished_books() {
    match {
        $m: Media { kind: "book", status: "finished" }
    }
    return { $m.slug, $m.name, $m.rating, $m.brief, $m.published_date }
    order { $m.rating desc }
}

query media_by_kind($kind: String) {
    match {
        $m: Media { kind: $kind }
    }
    return { $m.slug, $m.name, $m.status, $m.rating, $m.brief }
}

query media_authored_by($slug: String) {
    match {
        $m: Media { slug: $slug }
        $m mediaAuthoredBy $p
    }
    return { $p.slug, $p.name, $p.brief }
}

query media_recommended_by($slug: String) {
    match {
        $m: Media { slug: $slug }
        $m mediaRecommendedBy $p
    }
    return { $p.slug, $p.name, $p.relation }
}

query add_person($slug: String, $name: String, $relation: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Person { slug: $slug, name: $name, relation: $relation, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_event($slug: String, $name: String, $kind: String, $when: DateTime, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Event { slug: $slug, name: $name, kind: $kind, when: $when, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_place($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Place { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_organization($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Organization { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_note($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Note { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }

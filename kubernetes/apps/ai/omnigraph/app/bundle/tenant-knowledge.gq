query tenant_concepts() @description("Concepts every Run of the Tenant may read") {
  match {
    $c: Concept { scope: "tenant" }
  }
  return { $c.slug as slug, $c.scope as scope, $c.type as type, $c.title as title, $c.description as description, $c.resource as resource, $c.tags as tags, $c.body as body, $c.accepted_at as accepted_at }
  order { $c.slug asc }
  limit 500
}

query client_concepts($client: String) @description("Concepts scoped to one Client") {
  match {
    $c: Concept { scope: "client", client: $client }
  }
  return { $c.slug as slug, $c.scope as scope, $c.client as client, $c.type as type, $c.title as title, $c.description as description, $c.resource as resource, $c.tags as tags, $c.body as body, $c.accepted_at as accepted_at }
  order { $c.slug asc }
  limit 500
}

query repository_concepts($repository: String) @description("Concepts scoped to one repository") {
  match {
    $c: Concept { scope: "repository", repository: $repository }
  }
  return { $c.slug as slug, $c.scope as scope, $c.repository as repository, $c.type as type, $c.title as title, $c.description as description, $c.resource as resource, $c.tags as tags, $c.body as body, $c.accepted_at as accepted_at }
  order { $c.slug asc }
  limit 500
}

query concept_by_slug($slug: String) @description("One concept by slug; ploegd reads an accepted Promotion back with it") {
  match {
    $c: Concept { slug: $slug }
  }
  return { $c.slug as slug, $c.scope as scope, $c.from_note as from_note, $c.accepted_at as accepted_at }
  limit 1
}

query put_concept($slug: String, $scope: String, $client: String?, $repository: String?, $type: String, $title: String, $description: String?, $resource: String?, $tags: [String]?, $body: String, $from_note: String?, $accepted_by: String, $accepted_at: DateTime) @description("Write one accepted concept; only the review actor may change this graph") {
  insert Concept { slug: $slug, scope: $scope, client: $client, repository: $repository, type: $type, title: $title, description: $description, resource: $resource, tags: $tags, body: $body, from_note: $from_note, accepted_by: $accepted_by, accepted_at: $accepted_at }
}

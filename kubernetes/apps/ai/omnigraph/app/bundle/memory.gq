query notes_about($topic: String) @description("Notes filed under a topic, newest first") {
  match {
    $t: Topic { slug: $topic }
    $n about $t
  }
  return { $n.slug, $n.title, $n.created_at }
  order { $n.created_at desc }
  limit 50
}

query search_notes($q: String) @description("Full-text search over note bodies") {
  match {
    $n: Note
    search($n.body, $q)
  }
  return { $n.slug, $n.title, bm25($n.body, $q) as score }
  order { bm25($n.body, $q) desc }
  limit 20
}

query related_notes($slug: String) @description("Notes within two hops of a note") {
  match {
    $n: Note { slug: $slug }
    $n relates{1,2} $r
  }
  return { $r.slug, $r.title }
  limit 50
}

query add_note($agent: String, $slug: String, $title: String, $body: String, $topic: String) @description("Record a note by an agent under a topic") {
  insert Agent { name: $agent }
  insert Note { slug: $slug, title: $title, body: $body, created_at: now() }
  insert Wrote { from: $agent, to: $slug }
  insert About { from: $slug, to: $topic }
}

query add_topic($slug: String, $title: String) @description("Create or rename a topic") {
  insert Topic { slug: $slug, title: $title }
}

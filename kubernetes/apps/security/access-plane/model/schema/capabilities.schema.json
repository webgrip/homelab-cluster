{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgrip.io/access-plane/capabilities.schema.json",
  "title": "CapabilityCatalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capabilities"],
  "properties": {
    "apiVersion": { "const": "access.webgrip.io/v1alpha1" },
    "kind": { "const": "CapabilityCatalogue" },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "risk", "owner"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "risk": { "$ref": "#/$defs/risk" },
        "owner": { "$ref": "#/$defs/email" },
        "supersedes": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "derived": { "type": "boolean" },
        "break_glass": { "type": "boolean" },
        "alert": { "type": "string", "minLength": 1 },
        "projects": { "$ref": "#/$defs/projections" },
        "escalates_to": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "via"],
            "properties": {
              "capability": { "$ref": "#/$defs/slug" },
              "via": { "type": "string", "minLength": 1 },
              "requires": { "const": "collusion" }
            }
          }
        }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clusterRole", "scopable"],
          "properties": {
            "clusterRole": { "$ref": "#/$defs/slug" },
            "scopable": { "type": "boolean" }
          }
        },
        "authentik": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groups"],
          "properties": {
            "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
            "applications": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true }
          }
        },
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": { "policy": { "$ref": "#/$defs/slug" } }
        },
        "harbor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "enum": ["guest", "developer", "maintainer", "projectAdmin", "sysadmin"] },
            "scopable": { "type": "boolean" }
          }
        },
        "forgejo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team"],
          "properties": {
            "team": { "type": "string", "minLength": 1 },
            "siteAdmin": { "type": "boolean" }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["Viewer", "Editor", "Admin", "GrafanaAdmin"] } }
        },
        "litellm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["proxy_admin", "internal_user"] } }
        },
        "unfold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["admin", "operator", "viewer"] } }
        },
        "envoy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "securityPolicies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" } },
            "scopable": { "type": "boolean" }
          }
        },
        "talos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["os:admin", "os:operator", "os:reader"] } }
        },
        "longhorn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["admin"] } }
        }
      }
    }
  }
}

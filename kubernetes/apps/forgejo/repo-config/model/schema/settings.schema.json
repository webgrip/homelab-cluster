{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositorySettings",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "has_actions": { "type": "boolean" },
    "has_pull_requests": { "type": "boolean" },
    "has_releases": { "type": "boolean" },
    "default_merge_style": {
      "enum": ["merge", "rebase", "rebase-merge", "squash", "fast-forward-only"]
    },
    "default_delete_branch_after_merge": { "type": "boolean" },
    "allow_fast_forward_only_merge": { "type": "boolean" }
  }
}

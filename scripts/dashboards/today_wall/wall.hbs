{{#with wall}}
<div class="wall">
<section class="top">
<div class="who">
<div class="team">{{wallText title}}<small>{{wallText week.line}}</small></div>
<div class="days">{{#each week.cells}}<i class="day {{cls}}" title="{{name}}"></i>{{/each}}</div>
<div class="dayslabel"><span>{{wallText week.first}}</span><span>{{wallText week.last}}</span></div>
</div>
<a class="shipped" href="{{links.activity}}">
<div class="big">{{shipped.n}}<span>{{wallText shipped.word}}</span></div>
<div class="facts">{{#each shipped.facts}}<span class="fact {{cls}}">{{wallText pre}}<b>{{wallText b}}</b>{{wallText txt}}</span>{{/each}}</div>
</a>
</section>
{{#if available}}
<section class="band2">
<div class="where">
<div class="h">Where the work is <span class="legend"><span><i class="lb"></i>backlog</span><span><i class="lt"></i>to do</span><span><i class="ld"></i>doing</span><span><i class="lr"></i>reviewing</span><span><i class="lp"></i>done this week</span></span></div>
<div class="boards">
{{#each cards}}<a class="board" href="{{url}}">
<div class="bname"><span class="board-label">{{wallText name}}</span><small>{{wallText meta}}</small>{{#if flow}}<span class="flow {{flow.cls}}" title="{{wallText flow.last}}"><b>+{{flow.arrived}}</b> in · <b>{{flow.closed}}</b> out</span>{{/if}}{{#if lead}}<small class="lead">{{wallText lead}}</small>{{/if}}</div>
<div class="track">{{#each stations}}<div class="st {{cls}} {{fill}}"><span class="node">{{n}}</span><span class="lbl">{{wallText lbl}}</span>{{#if sub}}<span class="age{{#if late}} late{{/if}}" title="{{wallText why}}">{{wallText sub}}</span>{{/if}}</div>{{/each}}</div>
</a>
{{else}}<div class="calm">No open tickets on the boards and nothing closed this week.</div>
{{/each}}
{{#if quiet.length}}<div class="quiet">Empty this week: {{#each quiet}}{{#if @index}} · {{/if}}<b>{{wallText this}}</b>{{/each}}</div>{{/if}}
</div>
</div>
<div class="wins">
<div class="h">Wins this week</div>
{{#each wins}}<div class="win"><span class="k">{{wallText k}}</span><span class="v">{{wallText v}}{{#if unit}}<span>{{wallText unit}}</span>{{/if}}</span><span class="s">{{wallText s}}</span>{{#if bars}}<span class="streak">{{#each bars}}<i></i>{{/each}}</span>{{/if}}</div>
{{else}}<div class="calm">The week's first wins land here: the fastest push to green, the longest green streak, tickets closed.</div>
{{/each}}
</div>
</section>
<section class="machine">
{{#with machine}}
<a class="mcard" href="{{ci.url}}"><span class="k">{{wallText ci.k}}</span><span class="v">{{wallText ci.v}}<span>{{wallText ci.unit}}</span></span>{{#each ci.lines}}<span class="s {{cls}}">{{wallText txt}}</span>{{/each}}</a>
<a class="mcard" href="{{agents.url}}"><span class="k">{{wallText agents.k}}</span><span class="v">{{wallText agents.v}}<span>{{wallText agents.unit}}</span></span>{{#each agents.lines}}<span class="s {{cls}}">{{wallText txt}}</span>{{/each}}</a>
<a class="mcard spend" href="{{spend.url}}"><span class="k">{{wallText spend.k}}</span><span class="v">{{wallText spend.v}}<span>{{wallText spend.unit}}</span></span>{{#if spend.known}}<span class="bars">{{#each spend.projects}}<span class="bar"><span class="name">{{wallText name}}</span><span class="fill"><i style="width:{{w}}%"></i></span><span class="amt">{{wallText usd}} · {{wallText tokens}}</span></span>{{/each}}</span>{{#if spend.more}}<span class="s">and {{spend.more}} more</span>{{/if}}{{else}}<span class="s warn">LiteLLM ledger not answering</span>{{/if}}</a>
<a class="mcard" href="{{errors.url}}"><span class="k">{{wallText errors.k}}</span>{{#each errors.rates}}<span class="rate {{cls}}"><span class="rk">{{wallText k}}</span><b>{{wallText v}}</b><small>{{wallText s}}</small></span>{{/each}}</a>
{{/with}}
</section>
<section class="band3">
<div class="landed">
<div class="h">Just landed <em>newest first on the trunks · ✦ pushed by a bot account</em></div>
<div class="feed">
{{#each feed}}<a class="row" href="{{url}}"><span class="t">{{wallText t}}</span><span class="av{{#if agent}} ai{{/if}}">{{wallText who}}</span><span class="chip {{type}}">{{wallText type}}</span><span class="title"><b>{{wallText title}}</b><small>{{wallText where}}</small></span><span class="state {{ci.cls}}">{{wallText ci.txt}}</span></a>
{{else}}<div class="calm pad">Nothing has landed on a trunk in 30 days. The next push shows up here at the next refresh.</div>
{{/each}}
</div>
</div>
<div class="hand">
<div class="h">Could use a hand</div>
{{#each hand}}<a class="ask {{cls}}" href="{{url}}"><span class="k">{{wallText k}}</span><span class="v">{{wallText v}}</span>{{#if s}}<span class="s">{{wallText s}}</span>{{/if}}{{#if chips}}<span class="chips">{{#each chips}}<span>{{wallText c}} <b>{{n}}</b></span>{{/each}}</span>{{/if}}</a>
{{else}}<div class="calm">Nothing needs a hand. Every trunk green, no review waiting, nothing firing.</div>
{{/each}}
{{#if more}}<div class="calm">and {{more}} more on the walls</div>{{/if}}
</div>
</section>
{{else}}<div class="notice">{{wallText notice}}</div>{{/if}}
<footer class="foot"><span><a href="{{links.ci}}">Forgejo CI</a> · <a href="{{links.glide}}">Glide</a> · <a href="{{links.roadmap}}">Roadmap</a> · <a href="{{links.alerts}}">Alerts</a></span><span>{{#each foot}}{{#if @index}} · {{/if}}<span class="{{cls}}">{{wallText txt}}</span>{{/each}}</span></footer>
</div>
{{/with}}
